# Server-only settings. Never prefix secrets with NEXT_PUBLIC_.
# AI stays deterministic unless explicitly enabled.
AI_PROVIDER=mock

# Required on Vercel. Add Neon/Postgres through Vercel Marketplace and use its
# pooled connection URL with TLS. Select a region near your Vercel function.
DATABASE_URL=

# Required for Google executive sign-in. Register this redirect URI in Google
# Cloud Console: https://YOUR_DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Generate an unpredictable 32+ character value. Never expose it to the browser.
AUTH_SECRET=
# Administrators, comma-separated. These accounts can onboard members and
# assign the role each one acts as. Administration does NOT widen what they can
# read: every read is still evaluated against the persona they act as.
ADMIN_EMAILS=anuvikt@gmail.com

# Exact verified Google email -> synthetic executive or named assistant persona.
# Map a separate assistant account to p_ea to complete assistant-routed meetings.
# No wildcard domains or client-side role switching.
EXECUTIVE_MEMBER_MAP=you@example.com:p_ceo

# Optional later: explicitly choose AI_PROVIDER=openai or anthropic, then set
# BOTH the selected provider's API key and an available model ID in your account.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# LOCAL DEV ONLY: explicitly run a synthetic role-test session without Google.
# AUTH_MODE=demo
# LOCAL ONLY: use for npm run start without Postgres; Vercel ignores this.
# STORE_BACKEND=memory

# Feature flags (Sept 23 review). Off unless set to true.
# FEATURE_APPROVALS: show the separate Approvals queue. When off, confirmation
# happens inline (Book, Send) and policy + audit still run underneath.
FEATURE_APPROVALS=false
# FEATURE_VOICE_REPLIES: offer "Read replies aloud" (browser speech synthesis).
FEATURE_VOICE_REPLIES=false

# Where mail, calendar, and directory data come from. "synthetic" (default)
# uses src/data. "graph" selects the Microsoft Graph adapter, which is a stub
# in this prototype and fails loudly by design.
DATA_SOURCE=synthetic
